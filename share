
#!/bin/bash

CSV_FILE="hcsc_identity_cleanup_$(date +%Y%m%d_%H%M%S).csv"

echo "new_user,old_user,old_identity,migrated" > "$CSV_FILE"

echo "Collecting HCSC users from groups..."

oc get groups -o json | jq -r '
.items[].users[]? |
select(test("@hcsc\\.com$"; "i"))
' | sort -u | while read -r new_user
do

    echo "Processing: $new_user"

    #
    # Check if new user already exists
    #
    if oc get user "$new_user" >/dev/null 2>&1; then

        echo "$new_user,,,YES" >> "$CSV_FILE"
        echo "  -> Migrated user already exists. Skipping."

        continue
    fi

    #
    # User does not exist yet.
    # Find old accounts.
    #
    username="${new_user%@hcsc.com}"

    oc get users -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' \
    | grep "^${username}@" \
    | grep -v "@hcsc.com$" \
    | while read -r old_user
    do

        old_identity=$(oc get identities -o json | jq -r --arg USER "$old_user" '
            .items[]
            | select(.user.name == $USER)
            | .metadata.name
        ')

        #
        # Save to CSV
        #
        echo "$new_user,$old_user,$old_identity,NO" >> "$CSV_FILE"

        echo "  Old User     : $old_user"
        echo "  Old Identity : $old_identity"

        #
        # Delete old identity
        #
        if [ -n "$old_identity" ] && [ "$old_identity" != "null" ]; then

            echo "  Deleting identity: $old_identity"

            oc delete identity "$old_identity"

        fi

    done

done

echo
echo "================================================="
echo "Completed"
echo "CSV Report: $CSV_FILE"
echo "================================================="

