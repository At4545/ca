#!/bin/bash

#########################################
# Configuration
#########################################

NAMESPACE="openshift-monitoring"   # Change if needed
POD_PATTERN="cortex"
NODES_FILE="nodes.txt"

# true = only show pods
# false = actually delete pods
DRY_RUN=true

CSV_REPORT="cortex_pod_cleanup_$(date +%Y%m%d_%H%M%S).csv"

#########################################
# Validation
#########################################

if [ ! -f "$NODES_FILE" ]; then
    echo "ERROR: $NODES_FILE not found"
    exit 1
fi

echo "node,pod_name,action" > "$CSV_REPORT"

#########################################
# Process Nodes
#########################################

while read -r NODE
do
    [ -z "$NODE" ] && continue

    echo "========================================="
    echo "Processing Node: $NODE"
    echo "========================================="

    oc get pods -n "$NAMESPACE" -o json | jq -r \
      --arg node "$NODE" \
      --arg pattern "$POD_PATTERN" '
        .items[]
        | select(.spec.nodeName==$node)
        | select(.metadata.name | test($pattern))
        | .metadata.name
      ' | while read -r POD
      do

          [ -z "$POD" ] && continue

          if [ "$DRY_RUN" = true ]; then

              echo "[DRY RUN] Would delete pod: $POD"

              echo "$NODE,$POD,DRY_RUN" \
              >> "$CSV_REPORT"

          else

              echo "Deleting pod: $POD"

              oc delete pod "$POD" -n "$NAMESPACE"

              echo "$NODE,$POD,DELETED" \
              >> "$CSV_REPORT"

          fi

      done

done < "$NODES_FILE"

echo ""
echo "========================================="
echo "Completed"
echo "Report: $CSV_REPORT"
echo "========================================="
